{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Vite Dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "Vite Dev (accounts off)",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_SUPABASE_URL=",
        "VITE_SUPABASE_ANON_KEY=",
        "npm",
        "run",
        "dev"
      ],
      "port": 5183,
      "autoPort": true
    },
    {
      "name": "Vite Preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview"
      ],
      "port": 4173,
      "autoPort": true
    },
    {
      "name": "Escala Plugin UI",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5199",
        "--directory",
        "/Users/duscenko/sync-ds-platform/escala-figma-plugin/dist"
      ],
      "port": 5199
    },
    {
      "name": "Vercel Dev",
      "runtimeExecutable": "vercel",
      "runtimeArgs": [
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "Attach running Vite",
      "url": "http://localhost:5173",
      "port": 5173
    },
    {
      "name": "Storybook",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "storybook",
        "--",
        "--no-open",
        "--ci"
      ],
      "port": 6006,
      "autoPort": false
    },
    {
      "name": "Storybook (port 6016)",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "storybook",
        "dev",
        "-p",
        "6016",
        "-c",
        "apps/storybook/.storybook",
        "--no-open",
        "--ci"
      ],
      "port": 6016,
      "autoPort": false
    }
  ]
}
