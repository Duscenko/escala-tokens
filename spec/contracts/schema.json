{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.escalatokens.com/spec/contracts/schema.json",
  "title": "escala-component-contract/2",
  "description": "One Escala component: Figma anatomy, code API, the token each slot binds per state, motion, behaviour and where the code and story live. GENERATED by `npm run gen:contracts`.",
  "type": "object",
  "required": [
    "$schema",
    "key",
    "label",
    "category",
    "owners",
    "figma",
    "api",
    "anatomy",
    "tokens",
    "names",
    "bindings",
    "motion",
    "behaviour",
    "code",
    "docs"
  ],
  "properties": {
    "$schema": {
      "const": "escala-component-contract/2"
    },
    "$comment": {
      "type": "string"
    },
    "key": {
      "type": "string",
      "description": "PascalCase name, identical in Figma, React and Storybook."
    },
    "label": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "box": {
      "enum": [
        "black",
        "gray",
        "white"
      ],
      "description": "Black: shape, size, hit and motion locked · Gray: size, hit, motion · White: none."
    },
    "locks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "description": {
      "type": "string"
    },
    "owners": {
      "type": "object",
      "description": "Which side wins a disagreement (DEC-2026-11-16-007). Fix the other side.",
      "properties": {
        "anatomy": {
          "const": "figma"
        },
        "foundations": {
          "const": "figma"
        },
        "behaviour": {
          "const": "storybook"
        }
      }
    },
    "figma": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "page": {
          "type": [
            "string",
            "null"
          ]
        },
        "pageNodeId": {
          "type": [
            "string",
            "null"
          ]
        },
        "set": {
          "type": [
            "string",
            "null"
          ]
        },
        "variants": {
          "type": [
            "integer",
            "null"
          ]
        },
        "axes": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "properties": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            }
          }
        },
        "catalogueSets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "api": {
      "type": "object",
      "properties": {
        "axes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "defaults": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "props": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "anatomy": {
      "type": "object",
      "properties": {
        "slots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The first slot is the root (data-escala)."
        }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "description": "Every token ref the component can consume, by kind."
    },
    "names": {
      "type": "object",
      "description": "Token ref → CSS custom property and Figma variable / text style.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "css": {
            "type": "string"
          },
          "figma": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "bindings": {
      "type": "array",
      "description": "Recipe parts. To resolve a render: for each part, join the render's values of `axes` with `|` (defaults fill the gaps) and merge that entry's slots, in order.",
      "items": {
        "type": "object",
        "properties": {
          "axes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "values": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "motion": {
      "type": [
        "object",
        "null"
      ],
      "description": "Motion roles by name per slot and property, choreographies on enter / exit. null = no decision yet (MOT-002)."
    },
    "behaviour": {
      "type": "object",
      "properties": {
        "primitives": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "library": {
                "type": "string"
              },
              "pattern": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "keyboard": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "focus": {
                "type": "string"
              }
            }
          }
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ariaAttributes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "authored": {
          "type": [
            "object",
            "null"
          ],
          "description": "Keys and focus the component source adds (componentBehaviour.ts); pattern null = not interactive. null = not authored yet.",
          "properties": {
            "pattern": {
              "type": [
                "string",
                "null"
              ]
            },
            "keyboard": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "focus": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "story": {
              "type": "string"
            }
          }
        }
      }
    },
    "usage": {
      "type": "string"
    },
    "accessibility": {
      "type": "string"
    },
    "code": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "import": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "module": {
              "type": "string"
            },
            "exports": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "story": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "file": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "url": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "docs": {
      "type": "object",
      "properties": {
        "humanContract": {
          "type": [
            "string",
            "null"
          ]
        },
        "readable": {
          "type": "string"
        }
      }
    }
  }
}
